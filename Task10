import java.util.Scanner;

public class Task10 {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int[] a1 = new int[5];
        int[] a2 = new int[5];
        
        System.out.println("Enter 5 sorted numbers for first array:");
        for (int i = 0; i < 5; i++) {
            a1[i] = sc.nextInt();
        }
        
        System.out.println("Enter 5 sorted numbers for second array:");
        for (int i = 0; i < 5; i++) {
            a2[i] = sc.nextInt();
        }

        int[] merged = new int[10];
        int i = 0, j = 0, k = 0;

        while (i < 5 && j < 5) {
            if (a1[i] < a2[j]) {
                merged[k++] = a1[i++];
            } else {
                merged[k++] = a2[j++];
            }
        }

        while (i < 5) {
            merged[k++] = a1[i++];
        }
        while (j < 5) {
            merged[k++] = a2[j++];
        }

        System.out.println("Merged sorted array:");
        for (int x = 0; x < 10; x++) {
            System.out.print(merged[x] + " ");
        }

        int largest = merged[0];
        for (int x = 1; x < 10; x++) {
            if (merged[x] > largest) {
                largest = merged[x];
            }
        }
        System.out.println("\nLargest = " + largest);
        
    }
}
